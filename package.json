{
  "name": "movierank",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "import:trakt": "node scripts/import-trakt.mjs",
    "enrich": "node --env-file=.env scripts/enrich-tmdb.mjs",
    "sync": "npm run import:trakt && npm run import:shows && npm run enrich",
    "ratings:rebuild": "node scripts/rebuild-ratings.mjs",
    "backup": "node scripts/backup-ratings.mjs",
    "import:shows": "node scripts/import-shows.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
